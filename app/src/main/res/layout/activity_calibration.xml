<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Overlay transparente que captura os toques do usuario -->
    <View
        android:id="@+id/touchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <!-- Painel de instrucoes no topo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#EE000000">

        <TextView
            android:id="@+id/txtCalibTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calibration_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/txtCalibProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Botao 1 de 12"
            android:textSize="16sp"
            android:textColor="#FFD700"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/txtCalibBtnName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A1 (Square)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/txtCalibInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calibration_instructions"
            android:textSize="14sp"
            android:textColor="#CCCCCC"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnCalibSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calibration_skip"
                android:padding="10dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnCalibRedo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calibration_redo"
                android:padding="10dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnCalibCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calibration_cancel"
                android:padding="10dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Marcador central onde o usuario deve tocar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <View
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@android:drawable/ic_menu_add" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calibration_tap_here"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:paddingTop="8dp" />
    </LinearLayout>

    <!-- Botao finalizar no rodape (some ate o final) -->
    <Button
        android:id="@+id/btnCalibFinish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:text="@string/calibration_finish"
        android:padding="14dp"
        android:visibility="gone" />

</FrameLayout>
