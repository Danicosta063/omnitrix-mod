<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MKBot"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingBottom="20dp" />

        <Button
            android:id="@+id/btnFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_folder"
            android:padding="14dp"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_accessibility"
            android:padding="14dp"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnActivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activate_bot"
            android:padding="14dp"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#CCCCCC" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/character_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerCharacter"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bot_inactive"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:paddingBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#EEEEEE" />

        <TextView
            android:id="@+id/txtCharTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ashrah: 00:00:00"
            android:textSize="16sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/txtScorpionTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scorpion: 00:00:00"
            android:textSize="16sp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/txtTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tempo Total: 00:00:00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="20dp" />

        <TextView
            android:id="@+id/txtHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint"
            android:textSize="14sp"
            android:textColor="#888888"
            android:textAlignment="center" />

    </LinearLayout>
</ScrollView>
