<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MK Bot"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bot_off"
            android:padding="16dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnEnableA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_accessibility"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="24dp"
            android:background="#CCCCCC" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_label"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/txtTraining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/training_label"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/txtWins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wins_label"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/txtLosses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/losses_label"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/txtWinRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/winrate_label"
            android:gravity="center"
            android:textSize="16sp"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset_qtable"
            android:padding="16dp"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
