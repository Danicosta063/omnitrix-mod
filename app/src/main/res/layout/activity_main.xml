<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Titulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MK Bot"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/volume_instructions"
            android:textSize="13sp"
            android:textColor="#666666"
            android:paddingBottom="20dp"
            android:gravity="center" />

        <!-- Botoes de configuracao -->
        <Button
            android:id="@+id/btnA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_accessibility"
            android:padding="14dp"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_folder"
            android:padding="14dp"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCalibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calibrate_buttons"
            android:padding="14dp"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activate_bot"
            android:padding="14dp"
            android:textSize="15sp"
            android:layout_marginBottom="20dp" />

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="20dp" />

        <!-- Selecao de personagem -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/character_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerCharacter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <!-- Status do bot -->
        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bot_parado"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:paddingBottom="16dp" />

        <!-- Tempo de jogo -->
        <TextView
            android:id="@+id/txtHours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tempo de jogo: 00:00:00"
            android:textSize="16sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/txtCharTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="15sp"
            android:textColor="#555555"
            android:paddingBottom="16dp" />

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="16dp" />

        <!-- Estatisticas -->
        <TextView
            android:id="@+id/txtTraining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lutas treinadas: 0"
            android:textSize="15sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/txtWins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vitorias: 0"
            android:textSize="15sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/txtLosses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Derrotas: 0"
            android:textSize="15sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/txtWinRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Taxa de vitoria: 0.0%"
            android:textSize="15sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/txtPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pontos: 0"
            android:textSize="15sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/txtEpsilon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Epsilon: 0.600"
            android:textSize="15sp"
            android:paddingBottom="20dp" />

        <!-- Botao reset -->
        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset_qtable"
            android:padding="14dp"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
