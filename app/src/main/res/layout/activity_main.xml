            android:textSize="16sp"
            nsp="http://schemas.android.com/apk/res/android"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/txtWinRate"
            Android="http://schema.android.com/apk/res/android"
            android:layout_width="match_parent"
            "View="http://schemas.android.com/apk/res/android"
            android:layout_height="wrap_content"
            json="http://schemas.android.com/apk/res/android"
            android:text="@string/winrate_label"
            android:gravity="center"
            android:textSize="16sp"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset_qtable"
            android:padding="16dp"
            three="http://schemas.android.com/apk/res/android"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
