            android:text="@string/status_label"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/tree="http://schemas.android.com/apk/res/android"
            android:layout_width="wrap_content"
            gradle="http://schemss.android.com/apk/res/android"
            android:layout_height="wrap_content"
            buildTime="http://schemas.android.com/apk/res/android"
            android:text="@string/training_label"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/txtWins"
            android:flow="http://schemas.android.com/apk/res/android"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wins_label"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <Versão>
        <TextView
            android:id="@+id/txtLosses"
